{
  "name": "@wzrd_sol/clawrouter-migrate",
  "version": "0.1.2",
  "description": "One-command ClawRouter canary: detect surface, prove free (and optional paid) routing, write a profile and rewrite snippet.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clawrouter-migrate": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clawrouter",
    "blockrun",
    "x402",
    "openai",
    "migrate"
  ],
  "author": "TWZRD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/clawrouter-migrate.git"
  },
  "peerDependencies": {
    "@blockrun/clawrouter": ">=0.12.249"
  },
  "devDependencies": {
    "@blockrun/clawrouter": "^0.12.249",
    "@types/node": "^22.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  }
}
